# გაუშვი: node --env-file=.env server.js   (ან npm run dev)

# --- Discord ---------------------------------------------------------------
# Developer Portal → Bot → Token
DISCORD_BOT_TOKEN=
# Developer Portal → General Information → Application ID / Public Key
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
# სერვერის (guild) ID — არასავალდებულო.
# თუ შეავსებ, სლეშ-ბრძანებები მყისვე ჩნდება ამ სერვერზე; თუ არა — გლობალურად
# რეგისტრირდება (გავრცელებას ~1 საათი სჭირდება). ხმის კონტროლს არ სჭირდება.
DISCORD_GUILD_ID=
# hardcore რეჟიმის ხმოვანი არხი. თუ ცარიელია, ბოტი თვითონ შექმნის დროებით არხს
# (ამას სჭირდება Manage Channels უფლება).
DISCORD_SPYMASTER_CHANNEL_ID=
# ხელმძღვანელის მიკროფონის ფანჯრები (მილიწამებში)
DISCORD_CLUE_WINDOW_MS=20000
DISCORD_REACTION_WINDOW_MS=4000

# საიტის საჯარო მისამართი — აქედან შენდება პირადი ბმულები
PUBLIC_BASE_URL=http://localhost:3000

# --- Supabase --------------------------------------------------------------
# Project Settings → API. service_role გასაღები მხოლოდ სერვერზე ინახება!
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# anon გასაღები საჯაროა — მას კლიენტი Discord-ით შესვლისთვის იყენებს
SUPABASE_ANON_KEY=

# --- სერვერი ---------------------------------------------------------------
PORT=3000
